# Ignore k9s configuration (contains cluster-specific data)
k9s/

# Ignore GitHub Copilot tokens and configuration (contains OAuth tokens)
github-copilot/

# AI / agent tool state — regenerated locally, not worth versioning.
# Unanchored so they're ignored wherever they appear (top-level and nested,
# e.g. nvim/.omc, wezterm/.omc, yazi/.omc).
.omc/
.firecrawl/

# Standalone AI/dev tool config dirs (top-level only).
/crush/
/devin/
/flutter/
/goose/
/opencode/
/vercel-plugin/
/fish/

# Context7 MCP OAuth tokens
/context7/credentials.json

# mcphub server definitions can embed API keys once populated
/mcphub/

# cagent first-run marker, no content worth tracking
/cagent/

# herdr: keep config.toml (custom keybindings/theme), ignore local UI/session
# state, logs, and the plugin lockfile - all regenerate per machine.
/herdr/session.json
/herdr/*.log
/herdr/.plugins.lock

# tfenv: keep the version pin, ignore the downloaded binaries (regenerate with
# `tfenv install`).
/tfenv/versions/
